# Required for AI features (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_API_key"
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# RAG embeddings: tfidf (offline, default) or gemini
RAG_EMBEDDINGS=tfidf
# Optional live jobs (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Optional DB location
CAREERCOMPASS_DB=careercompass.db
